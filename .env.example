# Database Configuration
# Connect to your Neon / Vercel Postgres instance.
# Obtain this from your Vercel project settings or Neon dashboard.
DATABASE_URL="postgres://user:password@hostname/dbname?sslmode=require"

# Staff access
# Server-side code required for /staff access. Use a strong non-obvious value.
STAFF_ACCESS_CODE=change-me-to-a-strong-staff-code
